# HoodPups web — multi-stage, no host ports, non-root.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY tsconfig.base.json ./
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile
RUN pnpm --filter @hoodpups/web run build

FROM node:22-alpine AS runtime
# Serve as an unprivileged user. The container binds only inside its own network namespace; the
# stack publishes no host ports at all, so nothing here is reachable except via the edge proxy.
RUN addgroup -S app && adduser -S app -G app && apk add --no-cache wget
WORKDIR /srv
COPY --from=build --chown=app:app /app/apps/web/dist ./dist
RUN npm install -g serve@14.2.4
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["serve", "-s", "dist", "-l", "8080"]
