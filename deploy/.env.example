# HoodPups deploy environment — copy to deploy/.env, which is gitignored.
#
# NEVER commit real values. CI hard-fails on committed key material, and this repository is public.
# An RPC key pasted into a chat, an issue or a commit should be treated as compromised and rotated.

# From preflight.sh output. Never guess this.
EDGE_NET=

# The domain this stack will serve. Must already resolve to the box.
HOODPUPS_DOMAIN=

# 46630 = Robinhood Chain testnet, 4663 = mainnet. There is no mainnet deployment.
HOODPUPS_CHAIN_ID=46630

# RPC endpoint. Provider-agnostic on purpose — the app only needs a URL that speaks JSON-RPC for
# the configured chain id. Put the full URL including any key here, in this gitignored file only.
HOODPUPS_RPC_URL=
