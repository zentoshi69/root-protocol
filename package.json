{
  "name": "deriv-wtf",
  "version": "0.1.0",
  "private": true,
  "description": "One canonical Bitcoin Puppet inscription can create at most one verified HoodPup on Robinhood Chain. The original Puppet never leaves Bitcoin.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./services/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "vectors": "pnpm --filter @hoodpups/protocol-sdk run test:vectors",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:fmt": "cd contracts && forge fmt",
    "contracts:fmt:check": "cd contracts && forge fmt --check",
    "contracts:snapshot": "cd contracts && forge snapshot",
    "contracts:invariant": "cd contracts && forge test --match-path 'test/invariant/*'",
    "contracts:deep": "cd contracts && FOUNDRY_PROFILE=deep forge test",
    "abis": "cd contracts && forge build && node ../scripts/export-abis.mjs",
    "ci": "pnpm contracts:fmt:check && pnpm contracts:build && pnpm contracts:test && pnpm build && pnpm typecheck && pnpm test && pnpm vectors"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.21.3"
    }
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "viem": "2.21.55",
    "vitest": "3.2.6"
  }
}
