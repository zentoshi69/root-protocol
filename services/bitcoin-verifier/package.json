{
  "name": "@hoodpups/bitcoin-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independently verifies Bitcoin facts against the operator's own Bitcoin Core node and ord indexer. Never holds a key.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hoodpups/canonical-message": "workspace:*",
    "@hoodpups/protocol-sdk": "workspace:*",
    "bip322-js": "3.0.0",
    "viem": "2.21.55"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
