# ord does not publish a public container for 0.27.1. Build the test-only image from the official
# release artifact, verify the SHA-256 recorded by GitHub Releases, and pin the base by digest. The
# upstream Linux artifact is x86_64-only, so docker-compose.yml declares linux/amd64 explicitly.
FROM debian:bookworm-slim@sha256:362e64223cc0da95422b3b13c045186fc0a81250e765d31c025fbddf257f6143 AS fetcher

ARG ORD_VERSION=0.27.1
ARG ORD_SHA256=3e3631f8f170e31c813b3bea53440d7f1e1d0d82dcde944011a03166e057e037

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 --fail --show-error --location \
      "https://github.com/ordinals/ord/releases/download/${ORD_VERSION}/ord-${ORD_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
      --output /tmp/ord.tar.gz \
    && echo "${ORD_SHA256}  /tmp/ord.tar.gz" | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/ord.tar.gz --directory /tmp \
    && install --mode=0755 "/tmp/ord-${ORD_VERSION}/ord" /usr/local/bin/ord

FROM debian:bookworm-slim@sha256:362e64223cc0da95422b3b13c045186fc0a81250e765d31c025fbddf257f6143

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libssl3 wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /home/ord ord

COPY --from=fetcher /usr/local/bin/ord /usr/local/bin/ord

USER ord
WORKDIR /home/ord
ENTRYPOINT ["ord"]
